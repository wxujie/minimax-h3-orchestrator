# =============================================================================
#  MiniMax H3 Orchestrator — environment configuration
#  Copy to `.env` and fill in real values. All secrets live only in memory.
# =============================================================================

# ---------- Controller HTTP server -------------------------------------------
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8001

# ---------- Storage / data ----------------------------------------------------
DATABASE_URL=sqlite:///./storage/controller.db
STORAGE_DIR=./storage

# Relative paths to the bundled workflow + notebook definitions.
WORKFLOW_PATH=./workflows/workflow.json
NOTEBOOK_PATH=./notebooks/minimax-h3-comfyui.ipynb

# ---------- Public reachability (real notebook registration) ------------------
# Publicly reachable root of THIS controller. The pushed Kaggle notebook clones
# the orchestrator repo and POSTs /api/v1/agents/register to this URL when it
# comes up. It must be reachable FROM Kaggle, so point it at a deployed host or
# a controller-side tunnel (e.g. a cloudflared quick tunnel in front of :8000).
# Without this the notebook built for registration cannot round-trip and the
# scheduler will not start notebooks.
CONTROLLER_PUBLIC_URL=
# Repo the notebook clones to load the worker package + workflow adapter.
ORCHESTRATOR_REPO_URL=https://github.com/wxujie/minimax-h3-orchestrator

# ---------- Scheduling / reliability -----------------------------------------
MAX_JOB_RETRIES=2
JOB_OUTPUT_RETENTION_HOURS=24
MAX_CONCURRENT_NOTEBOOKS=2
SCHEDULER_POLL_S=5.0
JOB_POLL_S=3.0
# 单个任务最大渲染时长（秒）。短任务（5s 单镜）~20min，多镜头/参考图更长。
# 任务可在 API 里用 timeout_s 单独覆盖这个默认值。
JOB_TIMEOUT_S=7200
NOTEBOOK_START_WAIT_S=30
WORKER_HEALTH_TIMEOUT_S=30
WORKER_HEARTBEAT_TIMEOUT_S=60

# ---------- Security ----------------------------------------------------------
# Shared secret for controller <-> worker agent auth (required in production).
WORKER_AUTH_SECRET=replace-with-a-long-random-secret
WORKER_AUTH_REQUIRED=true

# ---------- Kaggle accounts ---------------------------------------------------
# Grab a key from kaggle.com/settings -> API. One block per account.
# The count is auto-discovered, so add more KAGGLE_ACCOUNT_<N>_* blocks freely.
KAGGLE_ACCOUNT_1_USERNAME=your-kaggle-username
KAGGLE_ACCOUNT_1_KEY=your-kaggle-api-key
KAGGLE_ACCOUNT_1_ENABLED=true
# Named-tunnel (locally-managed) credentials, generated once by:
#   scripts/create-worker-tunnel.sh <worker_id> <subdomain> <agent_port> <domain>
# KAGGLE_ACCOUNT_1_TUNNEL_CONFIG=<config.yml 内容>
# KAGGLE_ACCOUNT_1_TUNNEL_CREDENTIALS=<credentials.json 内容>

# KAGGLE_ACCOUNT_2_USERNAME=
# KAGGLE_ACCOUNT_2_KEY=
# KAGGLE_ACCOUNT_2_ENABLED=

# ---------- Colab accounts (google-colab-cli) ----------------------------------
# Colab uses the CLI's local OAuth login state, NOT a key in the environment.
# Run `colab status` once to authorize, then enable the account below.
# One block per account. GPU availability varies by subscription tier.
# COLAB_ACCOUNT_1_ID=colab-account-1
# COLAB_ACCOUNT_1_ENABLED=true
# COLAB_ACCOUNT_2_ENABLED=true

# ---------- Worker agent (runs inside the Kaggle/Colab notebook) --------------
# TUNNEL_MODE=quick   # quick (trycloudflare) or named (fixed domain, no login)
# TUNNEL_DOMAIN=      # e.g. tunnel.jayapp.cn — required for named mode
# CLOUDFLARED_BIN=/tmp/cloudflared
# Named mode workers read CLOUDFLARE_TUNNEL_CONFIG + CLOUDFLARE_TUNNEL_CREDENTIALS
# from the per-account *above* (not here).
# WORKER_AUTH_SECRET must match the controller's value.